{
  "name": "kinkeep",
  "version": "0.1.0",
  "description": "KinKeep — a self-hosted MCP server for elder-care coordination (Alexa+ track, Amazon Developer Hackathon 2026)",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "lint": "tsc --noEmit",
    "build": "tsc && cp src/schema.sql dist/schema.sql",
